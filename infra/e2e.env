# Settings for the end-to-end test stack (docker-compose.e2e.yml). Every value here is a
# throwaway used only by containers that the tests start and delete. Nothing in this
# file is a real credential, and none of it must ever be reused for a real environment.

# The one address a browser uses: the web container serves the app and proxies /api and
# /auth on it, over HTTPS with a certificate e2e-up.sh makes for this stack. Keycloak puts
# the address into every token as the issuer. To use another port, set E2E_WEB_PORT in
# your shell before running e2e-up.sh; the two addresses follow it.
E2E_WEB_PORT=8091
KEYCLOAK_PUBLIC_URL=https://localhost:${E2E_WEB_PORT}/auth
UCMS_APP_URL=https://localhost:${E2E_WEB_PORT}

POSTGRES_PASSWORD=e2e-postgres-password
IDENTITY_ACCESS_SVC_PASSWORD=e2e-identity-password
BASE_SVC_PASSWORD=e2e-base-password
ACADEMIC_STRUCTURE_SVC_PASSWORD=e2e-academic-password
ENROLLMENT_SVC_PASSWORD=e2e-enrollment-password
ASSIGNMENT_GRADING_SVC_PASSWORD=e2e-grading-password
NOTIFICATION_SVC_PASSWORD=e2e-notification-password
ANALYTICS_SVC_PASSWORD=e2e-analytics-password
KEYCLOAK_DB_PASSWORD=e2e-keycloak-db-password

REDIS_PASSWORD=e2e-redis-password
RABBITMQ_PASSWORD=e2e-rabbitmq-password
MINIO_ROOT_PASSWORD=e2e-minio-password
KEYCLOAK_ADMIN_PASSWORD=e2e-keycloak-admin-password

KC_SVC_IDENTITY_ACCESS_SECRET=e2e-secret-identity-access
KC_SVC_BASE_SECRET=e2e-secret-base
KC_SVC_ACADEMIC_STRUCTURE_SECRET=e2e-secret-academic-structure
KC_SVC_ENROLLMENT_SECRET=e2e-secret-enrollment
KC_SVC_ASSIGNMENT_GRADING_SECRET=e2e-secret-assignment-grading
KC_SVC_NOTIFICATION_SECRET=e2e-secret-notification
KC_SVC_ANALYTICS_REPORTING_SECRET=e2e-secret-analytics-reporting
