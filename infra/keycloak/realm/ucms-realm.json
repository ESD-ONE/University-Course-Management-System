{
  "realm": "ucms",
  "displayName": "UCMS",
  "displayNameHtml": "<b>UCMS</b> &middot; University Course Management System",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 86400,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and passwordHistory(3)",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": [
    "jboss-logging"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "UCMS administrator"
      },
      {
        "name": "LECTURER",
        "description": "UCMS lecturer"
      },
      {
        "name": "STUDENT",
        "description": "UCMS student"
      },
      {
        "name": "service",
        "description": "Marks a backend service's own service account"
      },
      {
        "name": "svc:identity",
        "description": "May call the identity service as a trusted service"
      },
      {
        "name": "svc:base",
        "description": "May call the base service as a trusted service"
      },
      {
        "name": "svc:academic",
        "description": "May call the academic service as a trusted service"
      },
      {
        "name": "svc:enrollment",
        "description": "May call the enrollment service as a trusted service"
      },
      {
        "name": "svc:grading",
        "description": "May call the grading service as a trusted service"
      },
      {
        "name": "svc:notification",
        "description": "May call the notification service as a trusted service"
      },
      {
        "name": "svc:analytics",
        "description": "May call the analytics service as a trusted service"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ucms-web",
      "name": "UCMS web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:8091/*",
        "https://esd.azhosting.fun/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:8091/*##https://esd.azhosting.fun/*"
      },
      "protocolMappers": [
        {
          "name": "ucms user id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "ucms_uid",
            "claim.name": "uid",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "svc-identity-access",
      "name": "svc-identity-access",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SVC_IDENTITY_ACCESS_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "svc-base",
      "name": "svc-base",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SVC_BASE_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "svc-academic-structure",
      "name": "svc-academic-structure",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SVC_ACADEMIC_STRUCTURE_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "svc-enrollment",
      "name": "svc-enrollment",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SVC_ENROLLMENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "svc-assignment-grading",
      "name": "svc-assignment-grading",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SVC_ASSIGNMENT_GRADING_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "svc-notification",
      "name": "svc-notification",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SVC_NOTIFICATION_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "svc-analytics-reporting",
      "name": "svc-analytics-reporting",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SVC_ANALYTICS_REPORTING_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-svc-identity-access",
      "enabled": true,
      "serviceAccountClientId": "svc-identity-access",
      "realmRoles": [
        "service"
      ],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    },
    {
      "username": "service-account-svc-base",
      "enabled": true,
      "serviceAccountClientId": "svc-base",
      "realmRoles": [
        "service",
        "svc:academic"
      ]
    },
    {
      "username": "service-account-svc-academic-structure",
      "enabled": true,
      "serviceAccountClientId": "svc-academic-structure",
      "realmRoles": [
        "service",
        "svc:identity"
      ]
    },
    {
      "username": "service-account-svc-enrollment",
      "enabled": true,
      "serviceAccountClientId": "svc-enrollment",
      "realmRoles": [
        "service",
        "svc:academic",
        "svc:identity"
      ]
    },
    {
      "username": "service-account-svc-assignment-grading",
      "enabled": true,
      "serviceAccountClientId": "svc-assignment-grading",
      "realmRoles": [
        "service",
        "svc:academic",
        "svc:enrollment",
        "svc:base",
        "svc:identity"
      ]
    },
    {
      "username": "service-account-svc-notification",
      "enabled": true,
      "serviceAccountClientId": "svc-notification",
      "realmRoles": [
        "service",
        "svc:enrollment",
        "svc:identity"
      ]
    },
    {
      "username": "service-account-svc-analytics-reporting",
      "enabled": true,
      "serviceAccountClientId": "svc-analytics-reporting",
      "realmRoles": [
        "service",
        "svc:identity",
        "svc:academic",
        "svc:enrollment",
        "svc:grading"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"ucms_uid\", \"displayName\": \"UCMS user id\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
