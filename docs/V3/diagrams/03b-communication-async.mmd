flowchart LR
    P1["Identity &amp; Access<br/>identity.user-created"] --> X{{"RabbitMQ topic exchange<br/>ucms.events"}}
    P2["Enrollment<br/>student-enrolled · student-waitlisted<br/>course-dropped · waitlist-promoted<br/>program-registered"] --> X
    P3["Assignment &amp; Grading<br/>assignment-published<br/>submission-received · grade-posted"] --> X
    P4["Analytics<br/>report-generated"] --> X
    X -->|"enrollment.# grading.#<br/>identity.# analytics.#"| QN["queue notification.events"]
    X -->|"enrollment.# grading.#<br/>identity.#"| QA["queue analytics.events"]
    QN --> NOT["Notification replicas<br/>(dedupe by event id)"]
    QA --> ANA["Analytics<br/>(recompute dashboards)"]
    QN -. "failed after retries" .-> DLQ["dead-letter queues"]
    QA -.-> DLQ
    NOT -->|"Redis pub/sub fan-out"| NR["replica holding<br/>the user's stream"]
    NR -->|"Server-Sent Events"| B(["Browser"])
    NOT -->|SMTP| M(["Email"])
