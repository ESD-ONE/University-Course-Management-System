flowchart LR
    U(["Browser<br/>Angular SPA"]) -->|HTTPS| NG["nginx edge<br/>TLS · headers · per-IP limits"]
    NG -->|/auth| KC["Keycloak<br/>identity provider"]
    NG -->|/api| GW["API Gateway<br/>JWT check · per-user limits · load balancing"]

    subgraph SVC["Microservices — one business capability each"]
        IAM["Identity & Access"]
        BASE["Base<br/>(faculties, departments, scales)"]
        ACAD["Academic Structure"]
        ENR["Enrollment"]
        GRD["Assignment & Grading"]
        NOT["Notification"]
        ANA["Analytics & Reporting"]
    end
    GW --> IAM & BASE & ACAD & ENR & GRD & NOT & ANA

    subgraph DB["PostgreSQL — one database, one schema per service"]
        S1[("identity_access")]
        S2[("base")]
        S3[("academic")]
        S4[("enrollment")]
        S5[("assignment_grading")]
        S6[("notification")]
        S7[("analytics")]
        S8[("keycloak")]
    end
    IAM --- S1
    BASE --- S2
    ACAD --- S3
    ENR --- S4
    GRD --- S5
    NOT --- S6
    ANA --- S7
    KC --- S8

    MQ{{"RabbitMQ<br/>event bus"}}
    RD[("Redis<br/>cache · limits · revocation")]
    MN[("MinIO<br/>files")]
    ENR & GRD & IAM & ANA -. publish events .-> MQ
    MQ -. consume .-> NOT & ANA
    GW --- RD
    GRD & ANA --- MN
