flowchart LR
    subgraph IAM["identity_access"]
        users["users"]
        rsa["role_scope_assignments"]
    end
    subgraph BASE["base"]
        departments["departments"]
        faculties["faculties"]
        grading_scales["grading_scales"]
    end
    subgraph ACAD["academic"]
        degree_programs["degree_programs"]
        course_catalog["course_catalog"]
        offerings["course_academic_years<br/>(offerings)"]
        academic_years["academic_years"]
    end
    subgraph ENR["enrollment"]
        spe["student_program_enrollments"]
        ce["course_enrollments"]
    end
    subgraph GRD["assignment_grading"]
        assignments["assignments"]
        submissions["submissions"]
    end
    subgraph NOT["notification"]
        notifications["notifications"]
    end

    faculties --> departments
    degree_programs -. department_id .-> departments
    course_catalog -. owning_department_id .-> departments
    offerings -. lecturer_id .-> users
    rsa -. scope_id (DEPARTMENT scope) .-> departments
    spe -. student_id .-> users
    spe -. degree_program_id .-> degree_programs
    spe -. intake_academic_year_id .-> academic_years
    ce -. student_id .-> users
    ce -. course_offering_id .-> offerings
    assignments -. course_offering_id .-> offerings
    submissions -. student_id .-> users
    submissions -. letter grade from .-> grading_scales
    notifications -. user_id .-> users

