---
title: "UCMS — High-Level Architecture (all components built)"
---
flowchart TB
    WEB["Angular SPA<br/>Admin · Lecturer · Student"]

    WEB -->|HTTPS REST| GW["API Gateway<br/>Spring Cloud Gateway — routing, CORS,<br/>JWT backstop, logout revocation"]
    WEB -->|"live push (Server-Sent Events,<br/>through the Gateway)"| GW

    subgraph SERVICES["Microservices Layer — 7 services"]
        IAM["Identity & Access"]
        ACAD["Academic Structure"]
        ENR["Enrollment"]
        GRADE["Assignment & Grading"]
        NOTIF["Notification<br/>(in-app, email, live push)"]
        ANALYTICS["Analytics & Reporting"]
        BASE["Base<br/>(reference data)"]
    end

    GW --> SERVICES

    subgraph DATALAYER["Data Layer"]
        PG[("PostgreSQL<br/>one database 'ucms', one schema per service")]
        REDIS[("Redis<br/>revoked-token list")]
        MINIO[("MinIO<br/>files and generated reports")]
    end

    SERVICES --> PG
    IAM --> REDIS
    GW --> REDIS
    GRADE --> MINIO
    ANALYTICS --> MINIO

    subgraph ASYNC["Asynchronous Backbone"]
        MQ{{"RabbitMQ<br/>ucms.events topic exchange"}}
    end

    IAM -.->|events| MQ
    ENR -.->|events| MQ
    GRADE -.->|events| MQ
    ANALYTICS -.->|events| MQ
    MQ -.-> NOTIF
    MQ -.-> ANALYTICS
    NOTIF -->|email| SMTP["SMTP relay"]

    subgraph PIPE["Delivery Pipeline"]
        GIT["Git"] --> CI["Jenkins CI/CD<br/>multibranch — builds + tests every branch,<br/>deploys develop / release / main"]
        CI --> DOCKER["Docker Images"]
        DOCKER --> DEPLOY["Containers on one VPS"]
    end

    DEPLOY -.->|releases| SERVICES
    DEPLOY -.->|nginx container serves the SPA and<br/>proxies /api/ to the Gateway| WEB

    classDef client fill:#3450D6,color:#fff,stroke:none
    classDef gateway fill:#E4E8FC,color:#161B29,stroke:#3450D6
    classDef svc fill:#FFFFFF,color:#161B29,stroke:#3450D6,stroke-width:2px
    classDef data fill:#FBEEDC,color:#161B29,stroke:#B4791F
    classDef async fill:#EEF2F6,color:#161B29,stroke:#64748B
    classDef pipe fill:#161B29,color:#fff,stroke:none

    class WEB client
    class GW gateway
    class IAM,ACAD,ENR,GRADE,NOTIF,ANALYTICS,BASE svc
    class PG,REDIS,MINIO data
    class MQ,SMTP async
    class GIT,CI,DOCKER,DEPLOY pipe
