flowchart TB
    WEB["Angular SPA<br/>Admin · Lecturer · Student"]

    WEB -->|HTTPS REST| GW["API Gateway<br/>routing · token check · rate limiting"]
    WEB <-.->|WebSocket| WSG["WebSocket Gateway<br/>real-time push"]

    subgraph SVCLAYER["Microservices Layer — 7 services"]
        SVC["Identity & Access · Academic Structure<br/>Enrollment · Assignment & Grading<br/>Notification · Analytics & Reporting<br/>Reference Data"]
    end

    GW --> SVCLAYER

    subgraph DATALAYER["Data Layer"]
        PG[("PostgreSQL<br/>one instance, one schema per service")]
        REDIS[("Redis<br/>cache + session store")]
    end

    SVCLAYER --> PG
    SVCLAYER <--> REDIS

    subgraph ASYNC["Asynchronous Backbone"]
        MQ{{"Message Broker<br/>RabbitMQ"}}
    end

    SVCLAYER -->|publish domain events| MQ
    MQ -->|consume events| SVCLAYER
    MQ --> WSG

    subgraph PIPE["Delivery Pipeline"]
        GIT["Git"] --> CI["Jenkins CI/CD"] --> DOCKER["Docker Images"] --> DEPLOY["Deployed Containers"]
    end

    DEPLOY -.->|releases| SVCLAYER

