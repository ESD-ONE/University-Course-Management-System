    }
    SCHEDULED_REPORTS {
        uuid id PK
        uuid report_id FK
        string frequency
        string recipients
        string status
        int version "optimistic lock — guards concurrent pause/resume"
        timestamptz created_at
        uuid created_by "ref Identity and Access, no FK"
        timestamptz updated_at
        uuid updated_by "ref Identity and Access, no FK"
        timestamptz deleted_at "nullable, soft delete"
        uuid deleted_by "ref Identity and Access, no FK, nullable"
    }

