---
title: "UCMS microservices — all 7 built. One PostgreSQL database ('ucms'), one schema per service, isolated by schema-scoped roles. Solid = synchronous REST; dotted = asynchronous events via RabbitMQ."
---
flowchart TB
    GW["API Gateway<br/>path routing + CORS<br/>JWT signature/expiry backstop<br/>logout-revocation check (Redis)"]

    IAM["1. Identity and Access<br/>Login, Users, Roles and Permissions,<br/>RBAC scope assignments, Profile, Logout"]
    IAMSCHEMA[("ucms.identity_access")]
    IAM --- IAMSCHEMA

    ACAD["2. Academic Structure<br/>Calendar, Programs, Curriculum,<br/>Catalog, Courses, Offerings"]
    ACADSCHEMA[("ucms.academic")]
    ACAD --- ACADSCHEMA

    ENR["3. Enrollment<br/>Program registration, Course enrollment,<br/>Waitlist, Registration log, Rosters"]
    ENRSCHEMA[("ucms.enrollment")]
    ENR --- ENRSCHEMA

    GRADE["4. Assignment and Grading<br/>Assignments, Submissions, Grades, GPA"]
    GRADESCHEMA[("ucms.assignment_grading")]
    GRADE --- GRADESCHEMA

    NOTIF["5. Notification<br/>In-app, Email, Live push (SSE), Preferences"]
    NOTIFSCHEMA[("ucms.notification")]
    NOTIF --- NOTIFSCHEMA

    ANALYTICS["6. Analytics and Reporting<br/>Role dashboards, Snapshots,<br/>Reports (CSV/PDF), Schedules"]
    ANALYTICSSCHEMA[("ucms.analytics")]
    ANALYTICS --- ANALYTICSSCHEMA

    BASE["7. Base (renamed from Reference Data)<br/>Faculties, Departments, Grading Scales, Categories"]
    BASESCHEMA[("ucms.base")]
    BASE --- BASESCHEMA

    GW --> IAM
    GW --> ACAD
    GW --> ENR
    GW --> GRADE
    GW --> NOTIF
    GW --> ANALYTICS
    GW --> BASE

    ACAD -->|role/permission catalog, every 60s| IAM
    BASE -->|department dependents check| ACAD
    ENR -->|offering open? capacity, lecturer;<br/>program/year validation| ACAD
    ENR -->|student lookup| IAM
    GRADE -->|offering lecturer, credits| ACAD
    GRADE -->|is student enrolled? rosters| ENR
    GRADE -->|grading scale bands| BASE
    NOTIF -->|recipients, emails| ENR
    NOTIF -->|email addresses| IAM
    ANALYTICS -->|reads| IAM
    ANALYTICS -->|reads| ACAD
    ANALYTICS -->|reads| ENR
    ANALYTICS -->|reads| GRADE

    MQ{{"RabbitMQ — topic exchange ucms.events<br/>queues with dead-letter queues"}}
    IAM -.->|identity.user-created| MQ
    ENR -.->|enrollment.*| MQ
    GRADE -.->|grading.*| MQ
    ANALYTICS -.->|analytics.report-generated| MQ
    MQ -.->|notification.events| NOTIF
    MQ -.->|analytics.events| ANALYTICS

    REDIS[("Redis<br/>revoked tokens")]
    MINIO[("MinIO<br/>submissions, briefs, reports")]
    SMTP["SMTP"]
    IAM -->|logout writes| REDIS
    GW -->|reads| REDIS
    GRADE --> MINIO
    ANALYTICS --> MINIO
    NOTIF --> SMTP

    classDef schema fill:#FBEEDC,stroke:#B4791F,color:#161B29
    classDef svc fill:#FFFFFF,stroke:#3450D6,stroke-width:2px,color:#161B29
    classDef gateway fill:#E4E8FC,color:#161B29,stroke:#3450D6
    classDef infra fill:#EEF2F6,stroke:#64748B,color:#161B29

    class IAMSCHEMA,ACADSCHEMA,ENRSCHEMA,GRADESCHEMA,NOTIFSCHEMA,ANALYTICSSCHEMA,BASESCHEMA schema
    class IAM,ACAD,ENR,GRADE,NOTIF,ANALYTICS,BASE svc
    class GW gateway
    class MQ,REDIS,MINIO,SMTP infra
