---
title: 5. Notification Service — ucms.notification schema (built)
---
erDiagram
    NOTIFICATIONS {
        uuid id PK
        uuid user_id "ref Identity and Access, no FK"
        string type "event type, e.g. grading.grade-posted"
        string category "REGISTRATION, ASSIGNMENT, GRADE, SYSTEM"
        string title
        text body
        string link "nullable, in-app route"
        uuid source_event_id "unique with user_id — dedupes redelivered events"
        timestamptz read_at "nullable"
        timestamptz created_at
        timestamptz updated_at "set when read_at changes"
    }
    NOTIFICATION_PREFERENCES {
        uuid id PK
        uuid user_id "ref Identity and Access, no FK — unique"
        boolean email_enabled
        boolean assignment_alerts
        boolean grade_alerts
        boolean registration_alerts
        int version "optimistic lock"
        timestamptz created_at
        timestamptz updated_at
        uuid updated_by
    }
