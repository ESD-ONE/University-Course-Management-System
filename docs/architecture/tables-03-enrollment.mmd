---
title: 3. Enrollment Service — ucms.enrollment schema (built)
---
erDiagram
    STUDENT_PROGRAM_ENROLLMENTS {
        uuid id PK
        uuid student_id "ref Identity and Access, no FK"
        uuid degree_program_id "ref Academic Structure, no FK"
        uuid intake_academic_year_id "ref Academic Structure, no FK"
        int current_year_of_study
        string status "ACTIVE, DEFERRED, WITHDRAWN, GRADUATED — one ACTIVE per student"
        int version "optimistic lock"
        timestamptz created_at
        uuid created_by
        timestamptz updated_at
        uuid updated_by
        timestamptz deleted_at "nullable, soft delete"
        uuid deleted_by "nullable"
    }
    COURSE_ENROLLMENTS {
        uuid id PK
        uuid student_id "ref Identity and Access, no FK"
        uuid course_offering_id "ref Academic Structure course_academic_years, no FK"
        date enrolled_on
        string status "ENROLLED, WAITLISTED, DROPPED, COMPLETED"
        int version "optimistic lock"
        timestamptz created_at
        uuid created_by
        timestamptz updated_at
        uuid updated_by
        timestamptz deleted_at "nullable, soft delete on drop"
        uuid deleted_by "nullable"
    }
    REGISTRATION_LOG {
        uuid id PK
        uuid student_id "ref Identity and Access, no FK"
        string target_type "PROGRAM or COURSE"
        uuid target_id "program id or course offering id"
        uuid actor_id "ref Identity and Access, no FK"
        string actor_role
        string action "PROGRAM_REGISTER, COURSE_ENROLL, COURSE_WAITLIST, COURSE_DROP, WAITLIST_PROMOTED, PROGRAM_UPDATE"
        timestamptz created_at
    }

    STUDENT_PROGRAM_ENROLLMENTS }o..o{ REGISTRATION_LOG : "audited (polymorphic target_id)"
    COURSE_ENROLLMENTS }o..o{ REGISTRATION_LOG : "audited (polymorphic target_id)"
