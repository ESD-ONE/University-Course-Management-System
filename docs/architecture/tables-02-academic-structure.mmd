---
title: "2. Academic Structure Service — ucms.academic schema (degree programs and courses are stable reference templates; their per-academic-year behaviour — status, overrides, which years they run in at all — lives in the two junction tables below, which is also why more than one ACADEMIC_YEARS row can be ACTIVE at once: a 3-4 year program legitimately spans several active years simultaneously)"
---
erDiagram
    ACADEMIC_YEARS {
        uuid id PK
        string name
        date start_date
        date end_date
        string status "ACTIVE | ARCHIVED | PLANNED; multiple rows may be ACTIVE at once"
        int version "optimistic lock"
        timestamptz created_at
        uuid created_by "ref Identity and Access, no FK"
        timestamptz updated_at
        uuid updated_by "ref Identity and Access, no FK"
        timestamptz deleted_at "nullable, soft delete"
        uuid deleted_by "ref Identity and Access, no FK, nullable"
    }
    SEMESTERS {
        uuid id PK
        uuid academic_year_id FK
        string name
        int sequence
        timestamptz enrollment_open_at
        timestamptz enrollment_close_at
        string status
        int version "optimistic lock"
        timestamptz created_at
        uuid created_by "ref Identity and Access, no FK"
        timestamptz updated_at
        uuid updated_by "ref Identity and Access, no FK"
        timestamptz deleted_at "nullable, soft delete"
        uuid deleted_by "ref Identity and Access, no FK, nullable"
    }
    DEGREE_PROGRAMS {
        uuid id PK
        string code UK
        string name
        uuid department_id "ref Reference Data, no FK"
        int duration_years "template default, per-year override in DEGREE_PROGRAM_ACADEMIC_YEARS"
        int total_credits "template default, per-year override in DEGREE_PROGRAM_ACADEMIC_YEARS"
        string status
        int version "optimistic lock"
        timestamptz created_at
        uuid created_by "ref Identity and Access, no FK"
        timestamptz updated_at
        uuid updated_by "ref Identity and Access, no FK"
        timestamptz deleted_at "nullable, soft delete"
        uuid deleted_by "ref Identity and Access, no FK, nullable"
    }
    DEGREE_PROGRAM_ACADEMIC_YEARS {
        uuid id PK
        uuid degree_program_id FK
        uuid academic_year_id FK
        int duration_years "nullable override"
        int total_credits "nullable override"
        string status "PLANNED | ACTIVE | DISCONTINUED"
        int version "optimistic lock"
        timestamptz created_at
        uuid created_by
        timestamptz updated_at
        uuid updated_by
        timestamptz deleted_at "nullable, soft delete"
        uuid deleted_by
    }
    COURSE_CATALOG {
        uuid id PK
        string code UK
        string name
        int default_credits
        uuid owning_department_id "ref Reference Data, no FK"
        int version "optimistic lock"
        timestamptz created_at
        uuid created_by "ref Identity and Access, no FK"
        timestamptz updated_at
        uuid updated_by "ref Identity and Access, no FK"
        timestamptz deleted_at "nullable, soft delete"
        uuid deleted_by "ref Identity and Access, no FK, nullable"
    }
    PROGRAM_COURSES {
        uuid id PK
        uuid degree_program_id FK
        uuid catalog_course_id FK
        string requirement_type
        int recommended_year
        int recommended_semester
        int credit_value
        int version "optimistic lock"
        timestamptz created_at
        uuid created_by "ref Identity and Access, no FK"
        timestamptz updated_at
        uuid updated_by "ref Identity and Access, no FK"
    }
    COURSES {
        uuid id PK
        uuid catalog_course_id FK
        uuid degree_program_id FK
        date begin_date
        int year_of_study
        uuid lecturer_id "ref Identity and Access, no FK; template default"
        int capacity "template default, per-year override in COURSE_ACADEMIC_YEARS"
        string status
        int version "optimistic lock"
        timestamptz created_at
        uuid created_by "ref Identity and Access, no FK"
        timestamptz updated_at
        uuid updated_by "ref Identity and Access, no FK"
        timestamptz deleted_at "nullable, soft delete"
        uuid deleted_by "ref Identity and Access, no FK, nullable"
    }
    COURSE_ACADEMIC_YEARS {
        uuid id PK
        uuid course_id FK
        uuid academic_year_id FK
        uuid semester_id FK "nullable"
        int capacity "nullable override"
        uuid lecturer_id "ref Identity and Access, no FK; nullable override"
        string status "DRAFT | PUBLISHED | CANCELLED"
        int version "optimistic lock — guards concurrent capacity edits"
        timestamptz created_at
        uuid created_by
        timestamptz updated_at
        uuid updated_by
        timestamptz deleted_at "nullable, soft delete"
        uuid deleted_by
    }

    ACADEMIC_YEARS ||--o{ SEMESTERS : "contains"
    ACADEMIC_YEARS ||--o{ DEGREE_PROGRAM_ACADEMIC_YEARS : "runs in"
    ACADEMIC_YEARS ||--o{ COURSE_ACADEMIC_YEARS : "offered in"
    SEMESTERS ||--o{ COURSE_ACADEMIC_YEARS : "scheduled in"
    DEGREE_PROGRAMS ||--o{ PROGRAM_COURSES : "requires"
    DEGREE_PROGRAMS ||--o{ DEGREE_PROGRAM_ACADEMIC_YEARS : "assigned to a year via"
    DEGREE_PROGRAMS ||--o{ COURSES : "offers"
    COURSE_CATALOG ||--o{ PROGRAM_COURSES : "referenced by"
    COURSE_CATALOG ||--o{ COURSES : "instantiated as"
    COURSES ||--o{ COURSE_ACADEMIC_YEARS : "assigned to a year via"
