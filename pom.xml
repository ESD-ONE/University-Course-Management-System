<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ucms</groupId>
    <artifactId>ucms-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>services/identity-access-service</module>
        <module>services/base-service</module>
        <module>services/academic-structure-service</module>
        <module>services/enrollment-service</module>
        <module>services/assignment-grading-service</module>
        <module>services/notification-service</module>
        <module>services/analytics-reporting-service</module>
        <module>services/gateway</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- Without this, @PathVariable/@RequestParam with no explicit name fail at
             request time (reflection can't recover parameter names from bytecode) —
             we were bitten by this once already; explicit names on the annotations are
             the primary fix, this is defense in depth for every usage after. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- Security patches newer than the ones Spring Boot ${spring-boot.version} manages
             (Tomcat 10.1.55, Netty 4.1.135, PostgreSQL driver 42.7.11, Jackson 2.21.4,
             RabbitMQ client 5.25.0). Each stays on the same major line, and on the same
             minor line where one exists. Drop one when Spring Boot's own version catches up. -->
        <tomcat.version>10.1.62</tomcat.version>
        <netty.version>4.1.141.Final</netty.version>
        <postgresql.version>42.7.15</postgresql.version>
        <jackson-bom.version>2.21.9</jackson-bom.version>
        <rabbit-amqp-client.version>5.38.0</rabbit-amqp-client.version>
        <!-- The MinIO client, and the patched versions of three libraries it brings in. -->
        <minio.version>8.6.0</minio.version>
        <guava.version>33.8.0-jre</guava.version>
        <bouncycastle.version>1.87</bouncycastle.version>
        <snappy-java.version>1.1.10.12</snappy-java.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!-- The version Spring Boot ${spring-boot.version} manages; set here because this project imports
             Spring Boot's BOM, which carries no plugin versions. -->
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <sonar-maven-plugin.version>4.0.0.4121</sonar-maven-plugin.version>
        <!-- The release that belongs to Spring Cloud ${spring-cloud.version}. The BOM manages
             the Spring Cloud Contract libraries but, like Spring Boot's, no plugin versions. -->
        <spring-cloud-contract.version>4.3.4</spring-cloud-contract.version>
        <!-- Shared by every module's jacoco:report — SonarQube reads this one file per
             module rather than needing a path listed per service. -->
        <jacoco.report.path>${project.build.directory}/site/jacoco/jacoco.xml</jacoco.report.path>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- The security patch versions set in <properties> above. A property alone has
                 no effect: Spring Boot's BOM resolves its own version placeholders, so they
                 have to be declared here, ahead of that BOM, to win. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.rabbitmq</groupId>
                <artifactId>amqp-client</artifactId>
                <version>${rabbit-amqp-client.version}</version>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy-java.version}</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <!-- Dev machines ahead of this project's JDK 17 target (e.g. JDK 24) hit
                         Mockito's bundled Byte Buddy refusing to instrument classes for
                         @MockBean: "Java 24 (68) is not supported ... officially supports
                         Java 23 (67)". This is Byte Buddy's own documented workaround —
                         same bytecode, just without its newest-JDK fast paths — and has no
                         effect on a build actually run under JDK 17. -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- @{argLine}: JaCoCo's prepare-agent execution below injects its
                             -javaagent flag into this property: a literal argLine here
                             (dropping the placeholder) silently skips coverage instead of
                             erroring, which is how this went unnoticed once before. -->
                        <argLine>@{argLine} -Dnet.bytebuddy.experimental=true</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <!-- Integration tests (*IT.java) start real infrastructure in containers,
                         so they run in `verify`, after the fast unit/API tests in `test`. -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <!-- Same reasons as surefire above. -->
                        <argLine>@{argLine} -Dnet.bytebuddy.experimental=true</argLine>
                        <!-- Failsafe runs after `package` and would otherwise test against
                             the repackaged Spring Boot jar, whose classes sit under
                             BOOT-INF/ where the test classpath cannot find them. -->
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- Contract tests: a service that other services call keeps one YAML
                         contract per endpoint or event under src/test/resources/contracts.
                         This plugin turns each into a test that runs in `test` against the
                         real controller; the calling service runs its real client against
                         the same file (its *ContractTest classes). A provider module adds
                         this plugin and names its own base class. -->
                    <groupId>org.springframework.cloud</groupId>
                    <artifactId>spring-cloud-contract-maven-plugin</artifactId>
                    <version>${spring-cloud-contract.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <testFramework>JUNIT5</testFramework>
                        <testMode>MOCKMVC</testMode>
                        <!-- Generate on every build. With the default (only when a contract
                             changed) a build that does not start from `clean` skips the
                             generated tests without saying so. -->
                        <incrementalContractTests>false</incrementalContractTests>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <!-- Not pluginManagement: every module inherits ucms-parent, so this one
             declaration gives every service coverage for free — `mvn test` alone emits
             target/site/jacoco/jacoco.xml per module, which sonar:sonar at the reactor
             root picks up automatically (see docs/V3 "Code Quality" slide / Jenkinsfile). -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
