<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ucms</groupId>
    <artifactId>ucms-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>services/identity-access-service</module>
        <module>services/base-service</module>
        <module>services/academic-structure-service</module>
        <module>services/enrollment-service</module>
        <module>services/assignment-grading-service</module>
        <module>services/notification-service</module>
        <module>services/analytics-reporting-service</module>
        <module>services/gateway</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- Without this, @PathVariable/@RequestParam with no explicit name fail at
             request time (reflection can't recover parameter names from bytecode) —
             we were bitten by this once already; explicit names on the annotations are
             the primary fix, this is defense in depth for every usage after. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.4</spring-boot.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <jacoco.version>0.8.12</jacoco.version>
        <sonar-maven-plugin.version>4.0.0.4121</sonar-maven-plugin.version>
        <!-- Shared by every module's jacoco:report — SonarQube reads this one file per
             module rather than needing a path listed per service. -->
        <jacoco.report.path>${project.build.directory}/site/jacoco/jacoco.xml</jacoco.report.path>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <!-- Dev machines ahead of this project's JDK 17 target (e.g. JDK 24) hit
                         Mockito's bundled Byte Buddy refusing to instrument classes for
                         @MockBean: "Java 24 (68) is not supported ... officially supports
                         Java 23 (67)". This is Byte Buddy's own documented workaround —
                         same bytecode, just without its newest-JDK fast paths — and has no
                         effect on a build actually run under JDK 17. -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- @{argLine}: JaCoCo's prepare-agent execution below injects its
                             -javaagent flag into this property: a literal argLine here
                             (dropping the placeholder) silently skips coverage instead of
                             erroring, which is how this went unnoticed once before. -->
                        <argLine>@{argLine} -Dnet.bytebuddy.experimental=true</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <!-- Not pluginManagement: every module inherits ucms-parent, so this one
             declaration gives every service coverage for free — `mvn test` alone emits
             target/site/jacoco/jacoco.xml per module, which sonar:sonar at the reactor
             root picks up automatically (see docs/V3 "Code Quality" slide / Jenkinsfile). -->
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
